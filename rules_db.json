  "lighting_formula": {
    "method": "광속법 (Lumen Method)",
    "method_ref": "KDS 32 30 10 4.7(2) - 실내전반 조명설계에 사용",
    "formula": "N = (E × A) / (F × U × M)",
    "variables": {
      "N": "필요 조명기구 수 (개)",
      "E": "설계 조도 (lux)",
      "A": "공간 면적 (m²)",
      "F": "조명기구당 총 광속 (lm) = flux_per_lamp_lm × lamps_per_fixture",
      "U": "조명률 (utilization factor, CU) - 실지수와 반사율로 결정",
      "M": "보수율 (maintenance factor, MF) - 청소주기·등기구 형태 반영"
    },
    "room_index_formula": "K = (L × W) / (H × (L + W))",
    "room_index_variables": {
      "K": "실지수 (room index)",
      "L": "공간 길이 (m)",
      "W": "공간 너비 (m)",
      "H": "작업면에서 광원까지 높이 (m)"
    },
    "work_plane_note": "작업면 높이는 KDS 32 30 10 4.3(3)에 따라 일반 0.85m, 바닥 작업 0.4m, 복도·옥외는 바닥면 기준",
    "alternative_method": {
      "method": "축점법 (Point-by-Point)",
      "use_case": "비상조명·국부조명·체육관·경기장 조도 계산",
      "ref": "KDS 32 30 10 4.7(3)"
    },
    "cu_table_note": "조명률(U)은 실지수(K)와 천장·벽·바닥 반사율에 따라 0.3~0.7 범위 적용 (공간별 utilization_factor_range 참조)"
  },
