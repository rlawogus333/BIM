    },
    {
      "rule_id": "V008",
      "rule_name": "접지 미설치 (기계실)",
      "description": "기계실 접지가 설치되지 않은 경우 위반",
      "applies_to": ["machinery"],
      "check_field": "grounded",
      "condition": "grounded == false",
      "severity": "error",
      "reference": "KEC 140·142 / KDS 32 40 20",
      "feedback_template": "기계실에 보호접지(저항 10Ω 이하)가 설치되지 않았습니다. KEC 140(접지시스템) 및 KEC 142.6(주접지단자)에 따라 접지 공사를 시행하십시오."
    },
    {
      "rule_id": "V009",
      "rule_name": "지하역사 비상전원 백업시간 부족",
      "description": "비상조명·유도등 비상전원 용량이 60분 미만일 경우 위반",
      "applies_to": "all",
      "check_field": "emergency_backup_actual_minutes",
      "condition": "emergency_backup_actual_minutes < 60",
      "severity": "error",
      "reference": "NFPC 303 제10조②",
      "feedback_template": "{space_name}의 비상전원 백업시간({emergency_backup_actual_minutes}분)이 지하역사 기준(60분)에 미달합니다. NFPC 303 제10조②에 따라 축전지 용량을 확대하십시오."
    },
    {
      "rule_id": "V010",
      "rule_name": "지하역사 복도 유도등 바닥 미설치",
      "description": "지하역사 복도·통로에 바닥 매립형 유도등이 설치되지 않은 경우 위반",
